COMPOSE_PROJECT_NAME=radius

# Shared RADIUS secret with the switches (clients.conf), e.g.: openssl rand -base64 24
RADIUS_SECRET=change-me

# "freeradius" = normal run, "-X" = debug (every packet in docker logs)
RADIUS_ARGS=freeradius

# RADIUS host for fetch-clients.sh (copies certs/clients/ to this machine)
RADIUS_REMOTE=<user>@<radius-host>
RADIUS_REMOTE_DIR=docker/radius8021x
