.env
test.out
# Site-specific switch list (template: raddb/clients.conf.example)
raddb/clients.conf
# Site-specific MAB allow list (template: raddb/authorized_macs.example)
raddb/authorized_macs
# Site-specific EAP-MD5 passwords (template: raddb/eap_md5_users.example)
raddb/eap_md5_users
# Site-specific PEAP-MSCHAPv2 passwords (template: raddb/peap_users.example)
raddb/peap_users
# Private keys and issued certificates: only on the RADIUS host, never in git
certs/*
!certs/.gitkeep

localdocs/
