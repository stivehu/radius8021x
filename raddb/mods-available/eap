# EAP module: EAP-TLS (cameras with client certificates), EAP-MD5 (password, raddb/eap_md5_users)
# and PEAP-MSCHAPv2 (password, raddb/peap_users, looked up in the inner-tunnel virtual server).
# TLS is offered first, except to the eap_md5_users identities (policy.d/md5_users);
# PEAP devices NAK it and ask for PEAP.
# entrypoint.sh copies the certificates to ${certdir}/site (source: ./mkcerts.sh, ./mkclient.sh).
eap {
    default_eap_type = tls
    timer_expire = 60
    ignore_unknown_eap_types = no
    cisco_accounting_username_bug = no
    max_sessions = ${max_requests}

    tls-config tls-common {
        private_key_file = ${certdir}/site/server.key
        certificate_file = ${certdir}/site/server.pem
        ca_file = ${certdir}/site/ca.pem
        dh_file = ${certdir}/site/dh

        cipher_list = "DEFAULT"
        cipher_server_preference = no

        # Many embedded supplicants (cameras, switches) still mishandle EAP-TLS over TLS 1.3
        tls_min_version = "1.2"
        tls_max_version = "1.2"

        fragment_size = 1024
        include_length = yes

        # The client certificate CN must match the EAP identity
        check_cert_cn = %{User-Name}

        cache {
            enable = no
        }

        verify {
        }

        ocsp {
            enable = no
        }
    }

    tls {
        tls = tls-common
    }

    md5 {
    }

    # The server certificate authenticates the RADIUS server; the device sends no certificate
    peap {
        tls = tls-common
        default_eap_type = mschapv2
        virtual_server = "inner-tunnel"
    }

    mschapv2 {
    }
}
